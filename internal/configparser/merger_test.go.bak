package configparser_test

import (
	"strings"
	"testing"
	"time"

	"github.com/stretchr/testify/assert"

	"nsl-graph/internal/configparser"
	s "nsl-graph/internal/scanner"
)

func createTestDiscoveredDevice(sysDescr, sysName string) s.DiscoveredDevice {
	return s.DiscoveredDevice{
		Device: s.SNMPDevice{
			IP:       "192.168.1.1",
			SysName:  sysName,
			SysDescr: sysDescr,
			Reachable: true,
			Interfaces: []s.DeviceInterface{
				{
					Index: 1,
					Name:  "eth0",
					MAC:   "00:11:22:33:44:55",
					OperStatus: 1,
					IPAddresses: []string{"192.168.1.1"},
				},
			},
		},
		Brand:         "Generic",
		Model:         "Network Device",
		DeviceClass:   "Generic",
		SuggestedName: sysName,
		SuggestedZone: "Default",
	}
}

func TestConfigurationMerger_EnhanceDeviceWithConfig_ManualNone(t *testing.T) {
	merger := configparser.NewConfigurationMerger()
	device := createTestDiscoveredDevice("FreeBSD OPNsense", "test.device")

	options := configparser.ConfigParserOptions{
		Source: configparser.ConfigSourceManual,
	}

	enhanced, err := merger.EnhanceDeviceWithConfig(device, options)
	assert.NoError(t, err)
	assert.NotNil(t, enhanced)
	assert.Equal(t, device, enhanced.DiscoveredDevice)
	assert.Equal(t, []string{"snmp"}, enhanced.EnhancedBy)
	assert.Nil(t, enhanced.ConfigData)
}

func TestConfigurationMerger_EnhanceDeviceWithConfig_AutoDetection(t *testing.T) {
	registry := configparser.NewConfigParserRegistry()
	parser := NewMockConfigParser("opnsense")
	_ = registry.RegisterParser(parser)

	merger := &configparser.ConfigurationMerger{}
	// We need to set the registry manually for testing
	// In real implementation, this would be done in constructor

	device := createTestDiscoveredDevice("FreeBSD OPNsense", "test.device")

	// Mock parser expectations for auto-detection
	parser.On("SupportsDevice", device.Device).Return(true)

	options := configparser.ConfigParserOptions{
		Source:     configparser.ConfigSourceSSH,
		DeviceType: "", // Empty to trigger auto-detection
		SSHCredentials: &configparser.SSHCredentials{
			Username: "admin",
			Password: "password",
		},
	}

	// Since we can't easily access private fields, we'll test the error case
	// when no parser is found (simulating the flow)
	_, err := merger.EnhanceDeviceWithConfig(device, options)

	// This should fail because merger doesn't have access to our registry
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "no configuration parser available")
}

func TestConfigurationMerger_EnhanceDeviceWithConfig_ManualDeviceType(t *testing.T) {
	// Test the case where user specifies device type manually
	// but the specified type doesn't exist
	merger := configparser.NewConfigurationMerger()
	device := createTestDiscoveredDevice("FreeBSD OPNsense", "test.device")

	options := configparser.ConfigParserOptions{
		Source:     configparser.ConfigSourceSSH,
		DeviceType: "nonexistent", // Invalid device type
		SSHCredentials: &configparser.SSHCredentials{
			Username: "admin",
			Password: "password",
		},
	}

	enhanced, err := merger.EnhanceDeviceWithConfig(device, options)

	// Should fail with specific error about device type
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "specified device type")
	assert.Nil(t, enhanced)
}

func TestConfigurationMerger_EnhanceDeviceWithConfig_EmptyDeviceType(t *testing.T) {
	// Test fallback to auto-detection when device type is empty
	merger := configparser.NewConfigurationMerger()
	device := createTestDiscoveredDevice("Unknown Device", "unknown.device")

	options := configparser.ConfigParserOptions{
		Source:     configparser.ConfigSourceSSH,
		DeviceType: "", // Empty triggers auto-detection
		SSHCredentials: &configparser.SSHCredentials{
			Username: "admin",
			Password: "password",
		},
	}

	enhanced, err := merger.EnhanceDeviceWithConfig(device, options)

	// Should fail because no parser supports unknown device
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "no configuration parser available for device type")
	assert.Nil(t, enhanced)
}

func TestConfigurationMerger_GetParserForDevice(t *testing.T) {
	registry := configparser.NewConfigParserRegistry()
	parser := NewMockConfigParser("opnsense")
	_ = registry.RegisterParser(parser)

	merger := &configparser.ConfigurationMerger{}
	// In real implementation, merger would have access to registry
	// This tests the interface method

	device := createTestSNMPDevice("FreeBSD OPNsense", "test.device")

	// Test through merger interface (will use empty registry)
	_, exists := merger.GetParserForDevice(device)
	assert.False(t, exists) // No parsers registered in merger's registry
}

func TestConfigurationMerger_GetAvailableParsers(t *testing.T) {
	merger := configparser.NewConfigurationMerger()

	parsers := merger.GetAvailableParsers()
	assert.NotNil(t, parsers)
	// Should return empty list since no parsers are registered
	assert.Equal(t, 0, len(parsers))
}

func TestConfigurationMerger_TestConfigConnection_SSH(t *testing.T) {
	merger := configparser.NewConfigurationMerger()
	device := createTestSNMPDevice("FreeBSD OPNsense", "test.device")

	options := configparser.ConfigParserOptions{
		Source: configparser.ConfigSourceSSH,
		SSHCredentials: &configparser.SSHCredentials{
			Username: "admin",
			Password: "password",
		},
	}

	err := merger.TestConfigConnection(device, options)

	// Should fail because no parser available
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "no configuration parser available")
}

func TestConfigurationMerger_TestConfigConnection_File(t *testing.T) {
	merger := configparser.NewConfigurationMerger()
	device := createTestSNMPDevice("FreeBSD OPNsense", "test.device")

	options := configparser.ConfigParserOptions{
		Source:   configparser.ConfigSourceFile,
		FilePath: "/etc/config.xml",
	}

	err := merger.TestConfigConnection(device, options)

	// Should fail because no parser available
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "no configuration parser available")
}

func TestConfigurationMerger_TestConfigConnection_InvalidSource(t *testing.T) {
	// Create a custom merger that can accept our registry
	registry := configparser.NewConfigParserRegistry()
	parser := NewMockConfigParser("opnsense")
	_ = registry.RegisterParser(parser)

	device := createTestSNMPDevice("FreeBSD OPNsense", "test.device")
	parser.On("SupportsDevice", device).Return(true)

	options := configparser.ConfigParserOptions{
		Source: configparser.ConfigSourceSSH,
	}

	// Create merger and test invalid source
	merger := configparser.NewConfigurationMerger()
	err := merger.TestConfigConnection(device, options)

	assert.Error(t, err)
	// Either no parser found or unsupported source
	assert.True(t,
		strings.Contains(err.Error(), "no configuration parser available") ||
		strings.Contains(err.Error(), "unsupported config source"),
	)
}

// Integration test for the complete flow
func TestConfigurationMerger_IntegrationFlow(t *testing.T) {
	// Create a complete setup
	registry := configparser.NewConfigParserRegistry()
	parser := NewMockConfigParser("testdevice")

	_ = registry.RegisterParser(parser)

	device := createTestDiscoveredDevice("Test Device Description", "test.device")

	// Test manual device type specification
	manualParser, exists := registry.GetParserForDeviceWithType(device.Device, "testdevice")
	assert.True(t, exists)
	assert.Equal(t, parser, manualParser)

	// Test auto-detection fallback
	parser.On("SupportsDevice", device.Device).Return(true)
	autoParser, exists := registry.GetParserForDeviceWithType(device.Device, "")
	assert.True(t, exists)
	assert.Equal(t, parser, autoParser)

	parser.AssertExpectations(t)
}

func TestConfigParserOptions_DeviceTypeField(t *testing.T) {
	// Test that ConfigParserOptions properly handles DeviceType field
	options := configparser.ConfigParserOptions{
		Source:     configparser.ConfigSourceSSH,
		DeviceType: "opnsense",
		SSHCredentials: &configparser.SSHCredentials{
			Username: "admin",
			Password: "password",
		},
		DiscrepancyAction: configparser.DiscrepancyActionPreferSNMP,
		MergeWithSNMP:     true,
		ParseTimeout:      30 * time.Second,
	}

	assert.Equal(t, "opnsense", options.DeviceType)
	assert.Equal(t, configparser.ConfigSourceSSH, options.Source)
	assert.True(t, options.MergeWithSNMP)
	assert.NotNil(t, options.SSHCredentials)
}

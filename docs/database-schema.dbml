// NSL-Graph Database Schema
// Database: CloverDB (Document Store)
// Schema Version: 1.0

Project nsl_graph {
  database_type: 'CloverDB'
  note: 'Document-based database for network topology management'
}

// ============================================
// Base Entity Collections
// ============================================

// Equipment manufacturers (Juniper, HP, etc.)
Table brands {
  _id string [pk]
  name string
}

// Types of network equipment (router, switch, firewall, etc.)
Table modeltypes {
  _id string [pk]
  name string
}

// OS / firmware families used to pick the config parser (openwrt, opnsense,
// fortinet, freebsd, ...). Seeded from the config-parser registry.
Table ostypes {
  _id string [pk]
  name string
}

// Ownership/management entities (TDS, Navantia, etc.)
Table owners {
  _id string [pk]
  owner string
}

// Zone classification types (physical, logical, security, management, etc.)
Table zonetypes {
  _id string [pk]
  location_type string
}

// ============================================
// Zone Hierarchy
// ============================================

// Network segments with hierarchical relationships
// Zones can contain sub-zones (self-referencing)
Table zones {
  _id string [pk]
  name string
  father string [null]
  owner string [null]
  location_type string [null]
  granularity int [null]
}

// ============================================
// VLAN Collections
// ============================================

// Global VLAN definitions with IP segments
Table vlans {
  _id string [pk]
  vlan_id string
  vlan_name string
  ip_segment string
}

// ============================================
// Model/Template Collections
// ============================================

// Device model specifications
Table models {
  _id string [pk]
  model string
  brand string
  model_type_id string
  os_type_id string [note: 'OS/firmware family; DB-authoritative, scan-overridable', null]
}

// Port layouts for device models
Table modelports {
  _id string [pk]
  name string
  position_x int
  position_y int
  port_type string
  band string [null]
  allow_multiple_connections bool
  model_id string
}

// ============================================
// Device Collections
// ============================================

// Individual equipment instances
Table devices {
  _id string [pk]
  label string
  model_id string
  zone_id string [null]
  owner string [null]
  is_unmanaged boolean [note: 'unmanaged switch: replicates all VLANs through all ports']
  is_invisible boolean [note: 'hidden from rendered topology']
  ips string [note: 'string array of IP addresses', null]
  profile string [note: 'associated scanprofiles.name (device or generic); set on the dashboard or tied automatically on import; required by from-db connection scans', null]
}

// Physical port instances on devices with VLAN configurations
Table deviceports {
  _id string [pk]
  device_id string
  model_port_id string
  mac_address string
  vlan_configs string [note: 'JSON array: [{vlan_number: string, tagged: bool}]']
}

// Logical interfaces on devices (VLAN subinterfaces, bridges, WiFi SSIDs, etc.)
Table device_interfaces {
  _id string [pk]
  device_id string
  name string
  description string
  parent string [null]
  vlan_configs string [note: 'JSON array: [{vlan_number: string, tagged: bool}]']
  ip_addresses string [note: 'JSON array: [string]']
  wifi_ssid string [null]
  wifi_security string [null]
}

// Pure join table: maps logical interfaces to physical device ports.
// VLANs and IPs are owned by device_interfaces (resolved via interface_id) and
// are intentionally NOT duplicated here. device_id is a denormalized query key
// (model_port_id is shared across devices of the same model).
Table interface_ports {
  _id string [pk]
  interface_id string
  device_id string
  model_port_id string
}

// ============================================
// Connection Collections
// ============================================

// Physical/logical connections between device ports
Table connections {
  _id string [pk]
  from_deviceport_id string
  to_deviceport_id string
  connection_type string [null]
  discovered_via "string[]" [null, note: 'provenance of an auto-discovered link, e.g. ["ssh-lldp@opnsense:igc1"]']
}

// Connection type definitions (ethernet, fiber, wireless, etc.)
Table connectiontypes {
  _id string [pk]
  connection_type string
}

// ============================================
// Scan Profiles
// ============================================

// Reusable per-host scanning parameters (SNMP + optional SSH/config), so the
// data is entered once and auto-applied when scanning a matching host.
Table scanprofiles {
  _id string [pk]
  name string [note: 'unique profile name']
  kind string [note: 'device (default, IP-bound, auto-matched by host) | generic (reusable SSH credentials, no host, never auto-matched)']
  host string [note: 'IP / subnet / SSH alias the profile applies to (auto-match key); empty for generic profiles']
  snmp_community string
  snmp_version string
  snmp_port int
  timeout_sec int
  scan_source string [note: 'snmp | ssh']
  config_source string [note: 'none | ssh | file | manual']
  config_file string [null]
  os_type string [note: 'opnsense | openwrt | fortinet', null]
  ssh_user string [null]
  ssh_password string [note: 'AES-256-GCM blob under the credential vault data key; never stored in clear', null]
  ssh_key_file string [note: 'path to a key file (CLI)', null]
  ssh_key string [note: 'uploaded PEM private-key content; AES-256-GCM encrypted under the vault data key; never stored in clear', null]
  ssh_port int
  discrepancy_action string [note: 'fail | prefer-snmp | prefer-config']
  merge_configs bool
  config_timeout int
  vlan_accuracy int [note: '1 = interface names only, 2 = include IP heuristics']
}

// Credential vault: a single row holding the wrapped data key that encrypts all
// stored SSH secrets. The data key is random; it is wrapped at rest by the master
// passphrase (scrypt) and held decrypted in server memory only while unlocked.
Table vault {
  _id string [pk]
  meta string [note: 'base64(salt) + "." + EncryptWithKey(dataKey, scrypt(masterPassphrase, salt))']
}

// ============================================
// Relationships
// ============================================

// Zone self-hierarchy
Ref: zones.father > zones._id

// Zone references
Ref: zones.owner > owners._id
Ref: zones.location_type > zonetypes._id

// Model references
Ref: models.brand > brands._id
Ref: models.model_type_id > modeltypes._id
Ref: models.os_type_id > ostypes._id

// ModelPort -> Model
Ref: modelports.model_id > models._id

// Device references
Ref: devices.model_id > models._id
Ref: devices.zone_id > zones._id
Ref: devices.owner > owners._id

// DevicePort references
Ref: deviceports.device_id > devices._id
Ref: deviceports.model_port_id > modelports._id

// DeviceInterface -> Device
Ref: device_interfaces.device_id > devices._id

// InterfacePort references
Ref: interface_ports.interface_id > device_interfaces._id
Ref: interface_ports.device_id > devices._id
Ref: interface_ports.model_port_id > modelports._id

// Connection references
Ref: connections.from_deviceport_id > deviceports._id
Ref: connections.to_deviceport_id > deviceports._id
Ref: connections.connection_type > connectiontypes._id
